COMSTAC_SMTP_ADDR=:2525
COMSTAC_SMTP_DOMAIN=mail.example.com
COMSTAC_SMTP_TLS_CERT=/absolute/path/to/dedicated-mail-fullchain.pem
COMSTAC_SMTP_TLS_KEY=/absolute/path/to/dedicated-mail-privkey.pem
COMSTAC_ACME_CHALLENGE_DIR=/absolute/read-only/path/to/.well-known/acme-challenge
COMSTAC_HTTP_ADDR=127.0.0.1:8080
COMSTAC_DB_PATH=/absolute/path/to/comstac.db
COMSTAC_ADMIN_USERNAME=admin
COMSTAC_ADMIN_PASSWORD=replace-with-a-long-random-password
COMSTAC_CSRF_SECRET=replace-with-at-least-32-random-characters
COMSTAC_SESSION_TTL_HOURS=24
COMSTAC_LOCAL_DOMAINS=example.com
COMSTAC_LOCAL_RECIPIENTS=local@example.com
COMSTAC_STORAGE_MAX_BYTES=10737418240
COMSTAC_STORAGE_MIN_FREE_BYTES=53687091200
COMSTAC_STORAGE_WARN_FREE_BYTES=80530636800

# ── Web Push Notifications (run `comstac vapid` to generate) ──
# COMSTAC_VAPID_PUBLIC=
# COMSTAC_VAPID_PRIVATE=
# COMSTAC_VAPID_SUBJECT=mailto:you@example.com

# ── Gmail OAuth2 Re-authorization (Web Application credentials) ──
# COMSTAC_BASE_URL=https://mail.example.com
# COMSTAC_OAUTH_CLIENT_ID=
# COMSTAC_OAUTH_CLIENT_SECRET=
